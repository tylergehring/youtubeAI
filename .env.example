# Copy to .env for local development. Never commit .env.

# --- Paths / tooling (all optional) ---
# VIDGEN_CONFIG_DIR=config
# VIDGEN_WORKSPACE_DIR=workspace
# FFMPEG_PATH=C:\tools\ffmpeg\bin\ffmpeg.exe

# --- Generic overrides of any settings.yaml value: VIDGEN__<section>__<key> ---
# VIDGEN__video__width=1920
# VIDGEN__video__height=1080

# --- Provider secrets (needed from later milestones; unused by the mock providers) ---
# OPENAI_API_KEY=sk-...   (required when providers.selected.llm is "openai")
# ANTHROPIC_API_KEY=
# ELEVENLABS_API_KEY=
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=
